PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Google Gemini AI (AI Agronomist + Crop Disease Diagnosis)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Chapa Payment Gateway (Escrow & Monetization)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here

# Base URLs (used for Chapa callback/return URLs)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

